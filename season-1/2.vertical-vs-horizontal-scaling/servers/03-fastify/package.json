{
  "name": "03-fastify",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsup --minify --watch --onSuccess \"node dist/server.js\"",
    "build": "tsup",
    "build:prod": "tsup --minify --clean",
    "start:prod": "pnpm build:prod && NODE_ENV=production MONGO_MODE=replica node dist/server.js",
    "seed:products": "tsup && node dist/seed-products.js",
    "seed:productsv2": "tsup && node dist/seed-products.js --collection=productsv2",
    "seed:test": "tsup && NODE_ENV=test node dist/seed-products.js",
    "start:test": "pnpm build:prod && NODE_ENV=test node dist/server.js",
    "typecheck": "tsc --noEmit",
    "mongo:up": "node scripts/mongo-preflight.mjs && docker compose -f infra/mongo/compose.yaml up -d",
    "mongo:down": "docker compose -f infra/mongo/compose.yaml down",
    "mongo:status": "bash infra/mongo/status.sh",
    "es:up": "docker compose -f infra/elasticsearch/compose.yaml up -d",
    "es:down": "docker compose -f infra/elasticsearch/compose.yaml down",
    "es:status": "curl -s http://127.0.0.1:9200/_cluster/health?pretty",
    "reindex:productsv2": "tsup && node dist/reindex-productsv2.js",
    "mongo:reset": "docker compose -f infra/mongo/compose.yaml down -v && node scripts/mongo-preflight.mjs && docker compose -f infra/mongo/compose.yaml up -d"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "negotiator": "^1.1.0",
    "redis": "^6.2.1",
    "swagger-jsdoc": "^6.3.0",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.4.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "type": "module"
}
